---
interface Props {
  title: string;
  description: string;
  /** 'article' for the article, else a page of the site. */
  type?: 'website' | 'article';
  fonts?: string[];
  /** Attributes for <body> (e.g. data-sections for the rails). */
  bodyAttrs?: Record<string, string>;
}
const { title, description, type = 'website', fonts = [], bodyAttrs = {} } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = Astro.site ?? Astro.url;
const url = new URL(Astro.url.pathname, site).href;
const image = new URL(`${base}share.png`, site).href;
const imageAlt = 'Design Book: design tokens that keep their reasons. A sentence on how Design Book stores the rule behind each token.';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#172c4f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="David Aerne" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href={`${base}logo.svg`} />
    <link rel="apple-touch-icon" href={`${base}touch-icon.png`} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Design Book" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:creator" content="@meodai" />
    <slot name="head" />
    {fonts.length > 0 && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {fonts.length > 0 && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fonts.map((href) => <link rel="stylesheet" href={href} />)}
  </head>
  <body {...bodyAttrs}>
    <slot />
    <script>
      // The wordmark in ASCII, for whoever opens the console.
      import logo from '../components/logo/logo.txt?raw';
      console.log(`\n${logo}\n`);
    </script>
    <script>
      // Safari's toolbar follows the rails' color, also when a page
      // recolors itself (the landing's palette).
      const meta = document.querySelector('meta[name="theme-color"]');
      const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
      let last = '';
      function sync() {
        const rail = document.querySelector('.rail');
        const color = rail
          ? getComputedStyle(rail).backgroundColor
          : getComputedStyle(document.body).getPropertyValue('--blue').trim();
        if (!color || !meta || !probe) return;
        probe.clearRect(0, 0, 1, 1);
        probe.fillStyle = color;
        probe.fillRect(0, 0, 1, 1);
        const [r, g, b] = probe.getImageData(0, 0, 1, 1).data;
        const hex = '#' + [r, g, b].map((n) => n.toString(16).padStart(2, '0')).join('');
        if (hex !== last) meta.setAttribute('content', (last = hex));
      }
      let queued = false;
      new MutationObserver(() => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => { queued = false; sync(); });
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['style', 'class'], subtree: true });
      sync();
    </script>
  </body>
</html>

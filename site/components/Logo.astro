---
// The wordmark: "DESIGNBOOK" in Valley Sans italic capitals on an open book
// (logo/book.ts draws the book). It is one shape in the text color, cut
// through a mask: the page is cut out, the background shows through.
import { book, maskShapes } from './logo/book';

// It links to the landing page: the class goes on the link, the drawing
// fills it.
const { class: className, thin = false } = Astro.props as { class?: string; thin?: boolean };
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// The letters' ink, measured from Valley Sans italic 800 at 30 in the
// book's leaned frame, relative to the text's anchor (its middle): from
// the D's stem to the K's arms, and above and below the baseline.
// thin: hairlines for the wordmark at the top of an intro (42px tall,
// about 0.87px to a unit): a 1px edge round the page, a 2px cover.
const b = book({ left: -108.2, right: 111.4, cap: 22.1, below: 0.4 }, thin ? { frame: 1.15, cover: 2.3, fold: 'normal' } : {});
const id = `logo-${Math.random().toString(36).slice(2, 8)}`;
---
<a class:list={['logo-link', className]} href={home} aria-label="Design Book, home">
<svg class="logo" viewBox={b.viewBox} aria-hidden="true">
  <defs>
    <mask id={id} maskUnits="userSpaceOnUse" x="-40" y="-20" width="340" height="110" set:html={maskShapes(b)} />
  </defs>
  <rect x="-40" y="-20" width="340" height="110" fill="currentColor" mask={`url(#${id})`} />
  <text x={b.x} y={b.baseline} text-anchor="middle" fill="currentColor">DESIGNBOOK</text>
</svg>
</a>

---
// The top line: "DesignBook" on the left, the book on the right.
// On the landing it is not a link (it is the home page); elsewhere it
// links home.
import Logo from './Logo.astro';
interface Props { link?: boolean; class?: string }
const { link = true, class: extra = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const Tag = link ? 'a' : 'p';
---
<Tag class:list={['brand-mark', extra]} href={link ? base : undefined}>
  <span>Design</span><Logo /><span>Book</span>
</Tag>

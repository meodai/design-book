---
// The bar along the bottom of the window: the name and the book on the
// left (a link home, except on the home page); on the right the pages
// (the current one named, not linked) and the install line. It comes to rest on top of the footer. Copy turns green for a
// moment once copied.
import Logo from './Logo.astro';
interface Props { home?: boolean; current?: 'tour' | 'article' | 'editor' }
const { home = false, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const Brand = home ? 'span' : 'a';
const links = [
  ['tour', 'Tour', `${base}tour/`],
  ['article', 'Article', `${base}article/`],
  ['editor', 'Editor', `${base}editor/`],
];
---
<div class="install-bar">
  <Brand class="bar-brand" href={home ? undefined : base}>
    <Logo /><span>Design Book</span>
  </Brand>
  <nav class="bar-nav" aria-label="Pages">
    {links.map(([id, label, href]) => (
      <a href={href} aria-current={id === current ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
  <code><span class="prompt">$</span> npm i design-book</code>
  <button class="copy" type="button" data-install-copy>Copy</button>
</div>

<script is:inline>
  // The first screen keeps the same space below its last line as beside
  // it: its bottom padding is the headline's inset from the rail plus the
  // bar's height. Runs as the bar is parsed (before the first paint) and
  // on resize, since the inset follows the window.
  (() => {
    const first = document.querySelector('.hero, .article-hero');
    const head = first && first.querySelector('.claim, h1');
    if (!head) return;
    const pad = () => {
      const rail = parseFloat(getComputedStyle(document.body).paddingLeft) || 0;
      const bar = document.querySelector('.install-bar');
      const inset = head.getBoundingClientRect().left - rail;
      first.style.paddingBottom = `${Math.round(inset + (bar ? bar.offsetHeight : 0))}px`;
    };
    pad();
    addEventListener('resize', pad);
  })();
</script>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-install-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('npm i design-book');
        button.textContent = 'Copied';
        button.classList.add('copied');
      } catch {
        button.textContent = 'Select it';
      }
      setTimeout(() => {
        button.textContent = 'Copy';
        button.classList.remove('copied');
      }, 1400);
    });
  }
</script>

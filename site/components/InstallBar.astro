---
// The bar along the bottom of the window: the name and the book on the
// left (a link home, except on the home page), the install line on the
// right. It comes to rest on top of the footer. Copy turns green for a
// moment once copied.
import Logo from './Logo.astro';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const Brand = home ? 'span' : 'a';
---
<div class="install-bar">
  <Brand class="bar-brand" href={home ? undefined : base}>
    <Logo /><span>DesignBook</span>
  </Brand>
  <code><span class="prompt">$</span> npm i design-book</code>
  <button class="copy" type="button" data-install-copy>Copy</button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-install-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('npm i design-book');
        button.textContent = 'Copied';
        button.classList.add('copied');
      } catch {
        button.textContent = 'Select it';
      }
      setTimeout(() => {
        button.textContent = 'Copy';
        button.classList.remove('copied');
      }, 1400);
    });
  }
</script>

---
// The bar along the bottom of the window: the name and the book on the
// left (a link home, except on the home page); on the right the pages
// (the current one named, not linked) and the install line. It comes to rest on top of the footer. Copy turns green for a
// moment once copied.
import Logo from './Logo.astro';
interface Props { home?: boolean; current?: 'tour' | 'article' | 'editor'; /** Pages without rails carry the book in the bar. */ logo?: boolean }
const { home = false, current, logo = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const Brand = home ? 'span' : 'a';
const links = [
  ['tour', 'Tour', `${base}tour/`],
  ['article', 'Article', `${base}article/`],
  ['editor', 'Editor', `${base}editor/`],
];
---
<div class="install-bar">
  <Brand class="bar-brand" href={home ? undefined : base}>
    {logo && <Logo />}<span>Design Book</span>
  </Brand>
  <nav class="bar-nav" aria-label="Pages">
    {links.map(([id, label, href]) => (
      <a href={href} aria-current={id === current ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
  <code><span class="prompt">$</span> npm i design-book</code>
  <button class="copy" type="button" data-install-copy>Copy</button>
</div>

<script>
  // The name starts on the page's text column, like the headline above;
  // the book hangs left of it. The column moves with the window, so the
  // bar measures it.
  const bar = document.querySelector<HTMLElement>('.install-bar');
  const column = document.querySelector<HTMLElement>('main h1, .claim, h1');
  function alignBrand() {
    if (!bar || !column) return;
    const edge = column.getBoundingClientRect().left - bar.getBoundingClientRect().left;
    bar.style.setProperty('--bar-text-left', `${Math.max(0, edge)}px`);
  }
  alignBrand();
  addEventListener('resize', alignBrand);
  addEventListener('load', alignBrand);

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-install-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('npm i design-book');
        button.textContent = 'Copied';
        button.classList.add('copied');
      } catch {
        button.textContent = 'Select it';
      }
      setTimeout(() => {
        button.textContent = 'Copy';
        button.classList.remove('copied');
      }, 1400);
    });
  }
</script>

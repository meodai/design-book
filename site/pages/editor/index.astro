---
import Page from '../../layouts/Page.astro';
import InstallBar from '../../components/InstallBar.astro';
import Footer from '../../components/Footer.astro';
import { partial } from '../../lib/partial';
import markup from '../../partials/editor.html?raw';
import '../../editor/style.css';
import '../../marketing/shared.css';
import '../../editor/theme.css';
const [beforeBrand, afterBrand] = partial(markup);
---
<Page
  title="Editor · Design Book"
  description="Write a design book in the browser: tokens with values, references and rules, rendered live to CSS, JSON, W3 Design Tokens and a dependency graph."
  fonts={['https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&display=swap']}
>
  <Fragment set:html={beforeBrand} />
  <Fragment set:html={afterBrand} />
  <InstallBar current="editor" />
  <Footer current="editor" />
  <script>
    import '../../editor/editor.ts';
    import '../../components/slider/slider.js';
  </script>
</Page>

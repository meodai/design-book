---
import Page from '../../layouts/Page.astro';
import InstallBar from '../../components/InstallBar.astro';
import Footer from '../../components/Footer.astro';
import { partial } from '../../lib/partial';
import markup from '../../partials/naming.html?raw';
import '../../marketing/shared.css';
import '../../naming/style.css';
const [beforeBrand, afterBrand] = partial(markup);
---
<Page
  title="Naming playground · Design Book"
  description="Try every naming scheme in Design Book, scaleNames, nameValues, nameBetween and namingScheme, on a live color ramp."
  fonts={['https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&display=swap']}
>
  <Fragment set:html={beforeBrand} />
  <Fragment set:html={afterBrand} />
  <InstallBar />
  <Footer current="naming" />
  <script>
    import '../../naming/demo.js';
    import '../../components/slider/slider.js';
  </script>
</Page>

---
import Page from '../../layouts/Page.astro';
import InstallBar from '../../components/InstallBar.astro';
import Folder from '../../components/Folder.astro';
import Sheet from '../../components/Sheet.astro';
import Slider from '../../components/Slider.astro';
import Footer from '../../components/Footer.astro';
import '../../marketing/shared.css';
import '../../naming/style.css';
---
<Page
  title="Naming playground · Design Book"
  description="Try every naming scheme in Design Book, scaleNames, nameValues, nameBetween and namingScheme, on a live color ramp."
  fonts={['https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&display=swap']}
>
  <section class="naming-hero">
    <h1>Naming playground.</h1>
    <p>
      Every naming scheme in Design Book, live: <code>nameValues</code>,
      <code>scaleNames</code>, <code>nameBetween</code> and
      <code>namingScheme</code>. Pick a scheme and a count; the colors are a
      ramp from the seed color, named and stored in a real Design Book scope.
      Only the options that fit the scheme are shown.
    </p>
  </section>

  <div class="naming">
    <form class="settings" onsubmit="return false">
      <p class="settings-head" data-ledger-head>Settings</p>
      <div class="settings-rows" data-ledger>
        <div class="field">
          <span class="lbl">scheme</span>
          <span class="ctl">
            <select id="scheme"></select>
            <small class="hint" id="scheme-hint"></small>
          </span>
        </div>
        <div class="field">
          <span class="lbl">count</span>
          <span class="ctl ctl-range">
            <Slider id="count" min="0" max="40" value="7" />
            <b id="count-val"></b>
          </span>
        </div>
        <div class="field">
          <span class="lbl">strategy</span>
          <span class="ctl">
            <span class="switch" id="anchor">
              <button type="button" data-v="default" class="is-active">default</button>
              <button type="button" data-v="start">start</button>
              <button type="button" data-v="base">base</button>
              <button type="button" data-v="range">range</button>
            </span>
            <small class="hint" id="anchor-hint"></small>
          </span>
        </div>
        <div class="field" id="base-field">
          <span class="lbl">base</span>
          <span class="ctl">
            <span class="switch" id="base-mode">
              <button type="button" data-mode="none" class="is-active">none</button>
              <button type="button" data-mode="centre">base: n</button>
              <button type="button" data-mode="pair">[n, name]</button>
            </span>
            <span class="ctl-range" id="base-controls">
              <Slider id="base-index" min="0" max="6" value="2" />
              <b id="base-index-val">2</b>
            </span>
            <input type="text" id="base-name" placeholder="name" />
            <small class="hint" id="base-hint"></small>
          </span>
        </div>
        <div class="field" id="range-field">
          <span class="lbl" id="range-lbl">from / to</span>
          <span class="ctl ctl-pair">
            <input type="text" id="from" placeholder="from" />
            <input type="text" id="to" placeholder="to" />
          </span>
        </div>
        <div class="field" id="step-field">
          <span class="lbl">step</span>
          <span class="ctl">
            <input type="number" id="step" placeholder="1" min="1" step="1" />
          </span>
        </div>
        <div class="field" id="case-field">
          <span class="lbl">case</span>
          <span class="ctl">
            <span class="switch" id="case">
              <button type="button" data-v="lower" class="is-active">lower</button>
              <button type="button" data-v="upper">upper</button>
            </span>
          </span>
        </div>
        <div class="field" id="overflow-field">
          <span class="lbl">overflow</span>
          <span class="ctl">
            <span class="switch" id="overflow">
              <button type="button" data-v="throw" class="is-active">throw</button>
              <button type="button" data-v="between">between</button>
            </span>
            <small class="hint">when the list runs out of names</small>
          </span>
        </div>
        <div class="field" id="custom-field">
          <span class="lbl">your list</span>
          <span class="ctl">
            <textarea id="custom" rows="3">hint, faint, subtle, soft, mid, firm, bold, strong, intense</textarea>
            <input type="text" id="custom-base" value="mid" placeholder="center name (optional)" />
            <small class="hint">smallest first</small>
          </span>
        </div>
        <div class="field">
          <span class="lbl">prefix / suffix</span>
          <span class="ctl ctl-pair">
            <input type="text" id="prefix" placeholder="prefix" />
            <input type="text" id="suffix" placeholder="suffix" />
          </span>
        </div>
        <div class="field">
          <span class="lbl">show as</span>
          <span class="ctl">
            <span class="switch" id="view">
              <button type="button" data-v="colors" class="is-active">colors</button>
              <button type="button" data-v="sizes">sizes</button>
            </span>
          </span>
        </div>
        <div class="field" id="seed-field">
          <span class="lbl">ramp seed</span>
          <span class="ctl">
            <color-input id="seed" value="#2d60a5" no-alpha=""></color-input>
          </span>
        </div>
      </div>
    </form>

    <div class="results">
      <Folder id="folder">
        <Sheet name="css" label="CSS"><pre is:raw class="code holes-left" id="css"></pre></Sheet>
        <Sheet name="code" label="Code"><pre is:raw class="code holes-left" id="code"></pre></Sheet>
        <Sheet name="names" label="Names" front>
            <p class="meta" id="meta"></p>
            <div class="error" id="error" hidden></div>
            <div class="tiles colors" id="tiles"></div>
          </Sheet>
      </Folder>

      <section class="growing">
        <h2>Growing the scale</h2>
        <p>
          The best names always come from running the naming again with the new
          count. Insert with <b>+</b> (<code>nameBetween</code>) only when the
          existing names have to stay: when CSS, components or a published token
          set already use them.
        </p>
        <div class="growing-rows" id="grown" data-ledger></div>
        <button type="button" class="rerun" id="rerun" hidden></button>
      </section>
    </div>
  </div>
  <InstallBar />
  <Footer current="naming" />
  <script>
    import '../../naming/demo.js';
  </script>
</Page>

---
import Page from '../layouts/Page.astro';
import BrandMark from '../components/BrandMark.astro';
import InstallBar from '../components/InstallBar.astro';
import Footer from '../components/Footer.astro';
import { partial } from '../lib/partial';
import markup from '../partials/landing.html?raw';
import '../../marketing/shared.css';
import '../../marketing/landing.css';
const [beforeBrand, afterBrand] = partial(markup);
---
<Page
  title="Design Book: design tokens that keep their reasons"
  description="Design Book stores the rule behind each design token, not only its value. Designers, developers and language models read the same rules."
  fonts={['https://fonts.googleapis.com/css2?family=Libertinus+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Libertinus+Serif:ital,wght@0,400;0,700;1,400&family=Valley+Sans:ital,wght@0,100..900;1,100..900&display=swap']}
>

  <Fragment set:html={beforeBrand} />
  <BrandMark link={false} class="brand" />
  <Fragment set:html={afterBrand} />
  <InstallBar />
  <Footer current="overview" />
  <script>
    import '../../marketing/landing.js';
  </script>
</Page>

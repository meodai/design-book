---
import Page from '../layouts/Page.astro';
import InstallBar from '../components/InstallBar.astro';
import Folder from '../components/Folder.astro';
import Sheet from '../components/Sheet.astro';
import Slider from '../components/Slider.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import '../marketing/shared.css';
import '../marketing/landing.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Page
  title="Design Book: design tokens that keep their reasons"
  description="Design Book stores the rule behind each design token, not only its value, so designers, developers and language models work from the same rules."
  fonts={['https://fonts.googleapis.com/css2?family=Libertinus+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Libertinus+Serif:ital,wght@0,400;0,700;1,400&family=Valley+Sans:ital,wght@0,100..900;1,100..900&display=swap']}
>

  <!-- Gutters along the page, graduated like the border of a map plate.
       Left: OKLCH lightness of the palette, ground and ink.
       Right: WCAG contrast between ground and ink. -->
  <aside class="rail rail-left" id="rail-left" aria-hidden="true">
    <span class="rail-legend">Lightness, OKLCH</span>
  </aside>
  <aside class="rail rail-right" id="rail-right" aria-hidden="true">
    <span class="rail-legend">Contrast, WCAG</span>
  </aside>

  <!-- ─── Hero: the claim as a live sentence ─────────────────────────── -->
  <section class="hero first-screen" id="hero">
    <Logo class="intro-logo" thin />
    <h1 class="claim" id="claim">
      <span class="out" data-out="ground"><span class="hash" aria-hidden="true">#</span><span class="hex">eee9dc</span></span>
      and
      <span class="out" data-out="ink"><span class="hash" aria-hidden="true">#</span><span class="hex">0d0a03</span></span>
      become
      <span class="call"><button class="pill fn" data-slot="fn1" type="button">lightest</button><span class="paren">(</span><button class="pill pool" data-slot="pal1" type="button">ledger</button><span class="paren">)</span></span>
      and
      <span class="call"><button class="pill fn" data-slot="fn2" type="button">bestContrastWith</button><span class="paren">(</span><span class="arg">ground</span>,&nbsp;<button class="pill pool" data-slot="pal2" type="button">ledger</button><span class="paren">)</span></span>:
      tokens that keep their reasons, so <span class="pill words" data-slot="who" role="button" tabindex="0">designers, developers and language models</span> can work from the same rules.
    </h1>


  </section>

  <!-- ─── The ledger: one book, live ───────────────────────────────────── -->
  <section class="section" aria-labelledby="ledger-title">
    <div class="section-head">
      <h2 class="rule-title rule-title--under" id="ledger-title">Bring your own design.</h2>
      <p>
        The rules don't make your design decisions for you. Your colors, sizes
        and type come from wherever you like: picked by eye, taken from a brand
        book or generated. Here the palette is
        <button class="pill source-pill" type="button" id="source-pill">drawn with Poline</button>.
        The book only decides what goes where: which color is ground, ink or
        accent, which size is the next step up. Change the inputs and every
        rule that reads them is worked out again.
      </p>
    </div>

    <!-- Two papers in a folder, one behind the other. Each has a tab on its
         top edge; selecting a tab brings that paper to the front. -->
    <Folder id="folder" class="folder--inset">
      <Sheet name="palette" label="Palette" as="article" class="sheet-palette holes-both" bodyClass="palette-body">
          <figure class="poline-panel">
            <div class="source-view" data-view="poline">
              <poline-picker id="poline-picker" tabindex="0" aria-label="Color wheel: drag around it, or use the arrow keys, to turn the palette"></poline-picker>
            </div>
            <div class="source-view" data-view="hand" hidden>
              <div class="hand-swatches" id="hand-swatches"></div>
            </div>
            <div class="source-view" data-view="ramp" hidden>
              <div class="ramp-strip" id="ramp-strip"></div>
              <label class="ramp-hue">Start hue <Slider id="ramp-hue" min="0" max="359" step="1" /></label>
            </div>
            <figcaption>
              <span class="source-switch switch" role="group" aria-label="Where the palette comes from">
                <button type="button" data-source="poline" aria-pressed="true">Poline</button>
                <button type="button" data-source="hand" aria-pressed="false">By hand</button>
                <button type="button" data-source="ramp" aria-pressed="false">RampenSau</button>
              </span>
              <span id="source-hint"></span>
            </figcaption>
          </figure>
          <table class="ledger" id="palette-table">
            <colgroup>
              <col class="c-no" /><col class="c-key" /><col class="c-rule" /><col class="c-val" />
            </colgroup>
            <thead>
              <tr><th>No.</th><th>Token</th><th>Source</th><th>Value</th></tr>
            </thead>
            <tbody id="palette-body"></tbody>
          </table>
          <table class="ledger ledger-fill" aria-hidden="true">
            <colgroup>
              <col class="c-no" /><col class="c-key" /><col class="c-rule" /><col class="c-val" />
            </colgroup>
            <tr><td class="no"></td><td></td><td></td><td></td></tr>
          </table>
        </Sheet>

      <Sheet name="sizes" label="Sizes" as="article" class="sheet-sizes" bodyClass="palette-body">
          <figure class="curve-panel">
            <svg id="curve" viewBox="-6 -6 112 112" role="img" aria-label="Curve that spreads the sizes from smallest to largest">
              <rect class="curve-frame" x="0" y="0" width="100" height="100" />
              <line class="curve-diagonal" x1="0" y1="100" x2="100" y2="0" />
              <g id="curve-steps"></g>
              <line class="curve-arm" id="arm-1" />
              <line class="curve-arm" id="arm-2" />
              <path class="curve-path" id="curve-path" />
              <circle class="curve-handle" id="handle-1" r="3.2" tabindex="0" aria-label="First handle" />
              <circle class="curve-handle" id="handle-2" r="3.2" tabindex="0" aria-label="Second handle" />
            </svg>
            <figcaption>Drag the handles to reshape the scale from <b id="size-min"></b> to <b id="size-max"></b>.</figcaption>
          </figure>
          <table class="ledger" id="sizes-table">
            <colgroup>
              <col class="c-no" /><col class="c-key" /><col class="c-rule" /><col class="c-val" />
            </colgroup>
            <thead>
              <tr><th>No.</th><th>Token</th><th>Source</th><th>Value</th></tr>
            </thead>
            <tbody id="sizes-body"></tbody>
          </table>
          <table class="ledger ledger-fill" aria-hidden="true">
            <colgroup>
              <col class="c-no" /><col class="c-key" /><col class="c-rule" /><col class="c-val" />
            </colgroup>
            <tr><td class="no"></td><td></td><td></td><td></td></tr>
          </table>
        </Sheet>

      <Sheet name="graph" label="Graph" as="article" class="sheet-graph" bodyClass="graph-body blueprint">
          <div class="graph" id="graph" role="img" aria-label="Every scope of the book as a table, with a line for each reference between tokens"></div>
          <p class="graph-note">Rendered with <code is:raw>book.render('svg', { interactive: true })</code>. Point at a token to follow its references.</p>
        </Sheet>

      <Sheet name="rules" label="Rules" as="article" class="sheet-rules" front>
          <table class="ledger" id="ledger">
            <colgroup>
              <col class="c-no" /><col class="c-key" /><col class="c-rule" /><col class="c-val" />
            </colgroup>
            <thead>
              <tr><th>No.</th><th>Token</th><th>Rule</th><th>Value</th></tr>
            </thead>
            <tbody id="ledger-body"></tbody>
          </table>
        </Sheet>
    </Folder>
  </section>

  <!-- ─── Three readers ───────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="readers-title">
    <div class="section-head">
      <h2 class="rule-title rule-title--under" id="readers-title">One book for designers, developers and language models.</h2>
      <p>
        A hex code doesn't tell you why it was picked. A rule does, and
        each of them can read it in their own form. The sheets below are rendered
        from the same book as the sentence at the top of this page.
      </p>
    </div>

    <div class="sheets">
      <article class="sheet sheet-mint is-cut" tabindex="0" aria-expanded="false">
        <header><h3>For designers</h3><span>The rule, in words</span></header>
        <ol class="prose-rules" id="read-designer"></ol>
      </article>
      <article class="sheet sheet-cream holes-left">
        <header><h3>For developers</h3><span>CSS custom properties</span></header>
        <pre is:raw id="read-dev"></pre>
      </article>
      <article class="sheet sheet-lilac is-cut" tabindex="0" aria-expanded="false">
        <header><h3>For language models</h3><span>The source, as plain data</span></header>
        <pre is:raw id="read-llm"></pre>
      </article>
    </div>
    <p class="sheets-note">
      Tokens are plain, serializable data with no closures. A model can
      change <code>darkest</code> to <code>mostVivid</code> and explain the
      change, instead of making up a new hex code. The package ships a
      <a href="https://github.com/meodai/design-book/blob/main/skills/design-book.md">skill file</a>
      that teaches agents to move an existing system onto rules.
    </p>
  </section>

  <!-- ─── Principles ──────────────────────────────────────────────────── -->
  <section class="section" aria-labelledby="principles-title">
    <div class="section-head">
      <h2 class="rule-title rule-title--under" id="principles-title">What it is built on</h2>
    </div>

    <dl class="principles ruled-list">
      <div>
        <dt>You bring the values</dt>
        <dd>Rules pick and mix the colors, sizes and type you give them; they don't make up their own. Make the primitives however you like, with a generator, a brand book or by eye, and write a plain value wherever a rule isn't what you mean.</dd>
      </div>
      <div>
        <dt>Rules, not values</dt>
        <dd>Selectors pick from a scope (<code>darkest</code>, <code>closest</code>, <code>bestContrastWith</code>). Transforms derive from a token (<code>lighten</code>, <code>colorMix</code>, <code>ramp</code>). A plain value is fine wherever a fixed value is what you mean.</dd>
      </div>
      <div>
        <dt>Contrast built in</dt>
        <dd>Pass <code>readableOn</code> to any color selector and it only considers colors that meet WCAG contrast on that surface. When nothing passes, you get an error instead of an unreadable color.</dd>
      </div>
      <div>
        <dt>A dependency graph</dt>
        <dd>Every reference is an edge. Changing a token re-resolves exactly what depends on it, and a write that would create a cycle is refused.</dd>
      </div>
      <div>
        <dt>Scopes inherit</dt>
        <dd>A <code>button-danger</code> scope extends <code>button</code> and overrides only its background. Relative references such as <code>ref('.bg')</code> resolve in the scope that inherits them.</dd>
      </div>
      <div>
        <dt>Variations are books</dt>
        <dd>Each theme, brand or breakpoint is a separate book built by the same function. Render one fully and the others as the differences from it.</dd>
      </div>
      <div>
        <dt>One source, many outputs</dt>
        <dd>CSS custom properties that keep <code>var()</code>, <code>color-mix()</code> and <code>calc()</code> live in the browser, resolved JSON, or W3C Design Tokens.</dd>
      </div>
    </dl>
  </section>

  <!-- ─── Start ───────────────────────────────────────────────────────── -->
  <section class="section start" aria-labelledby="start-title">
    <div class="section-head">
      <h2 class="rule-title rule-title--under" id="start-title">Start with one rule.</h2>
    </div>
    <div class="start-grid">
  <pre is:raw class="start-code holes-left">import {
  DesignBook, color, ref, darkest, bestContrastWith,
} from 'design-book';

const book = new DesignBook('site');
const ledger = book.addScope('ledger');
ledger.set('paper', color('#eee9dc'));
ledger.set('ink',   color('#22201c'));

const ui = book.addScope('ui');
ui.set('ground', darkest(ref('ledger')));
ui.set('ink',    bestContrastWith(ref('ui.ground'), ref('ledger')));

book.render('css-variables');</pre>
      <ul class="start-links ruled-list">
        <li><a href={`${base}tour/`}>Tour</a><span>Every function and renderer, with live examples</span></li>
        <li><a href={`${base}editor/`}>Editor</a><span>Write a book in the browser and watch it resolve</span></li>
        <li><a href={`${base}article/`}>Article</a><span>The longer argument for rules over values</span></li>
        <li><a href="https://github.com/meodai/design-book#readme">Docs</a><span>The full reference, in the README</span></li>
        <li><a href="https://github.com/meodai/design-book">Source</a><span>TypeScript, ESM, AGPL-3.0</span></li>
      </ul>
    </div>
  </section>
  <InstallBar home />
  <Footer current="overview" />
  <script>
    import '../marketing/landing.js';
    import '../marketing/blueprint.js';
  </script>
</Page>

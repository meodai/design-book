  <!-- ─── One source, many outputs ─────────────────────────────────── -->
  <section class="renderers">
    <header class="renderers-head">
      <h2 class="rule-title">Many outputs from one book.</h2>
      <p>The same book renders to CSS variables, JSON and the
        <a href="https://www.designtokens.org/tr/drafts/format/">W3 Design Tokens</a>
        format out of the box. A custom renderer is one call,
        <code>book.registerRenderer(name, fn)</code>, and about twenty lines of
        TypeScript turn the graph into a Tailwind config, Swift extensions,
        SwiftUI, Kotlin or whatever JSON dialect you need.</p>
    </header>

    <Folder class="renderer-folder folder--inset" tabRow>
      <Sheet name="renderer" class="folder-sheet--r-tailwind" label="Tailwind"><pre class="r-pane" id="r-tailwind"></pre></Sheet>
      <Sheet name="renderer" class="folder-sheet--r-w3" label="W3"><pre class="r-pane" id="r-w3"></pre></Sheet>
      <Sheet name="renderer" class="folder-sheet--r-json" label="JSON"><pre class="r-pane" id="r-json"></pre></Sheet>
      <Sheet name="renderer" class="folder-sheet--r-css" label="CSS" front><pre class="r-pane is-active" id="r-css"></pre></Sheet>
    </Folder>

    <details class="renderer-source">
      <summary>The custom Tailwind renderer in full</summary>
  <Code is:raw>// A renderer is a function from `book` to a string. That's the whole API.
function tailwindRenderer(book) {
  const colors = {}, spacing = {};
  const isColor     = (s) =&gt; parse(s) != null;
  const isDimension = (s) =&gt; /^-?\d+(\.\d+)?[a-z%]+$/i.test(s);

  for (const scope of book.getAllScopes()) {
    for (const k of scope.getAllKeys()) {
      const v = scope.resolve(k);
      const key = `${scope.name}-${k}`;
      if (isColor(v))     colors[key]  = v;
      else if (isDimension(v)) spacing[key] = v;
    }
  }
  return `module.exports = { theme: { extend: ${JSON.stringify({ colors, spacing }, null, 2)} } }`;
}

// Register it under any name; it works like the built-ins.
book.registerRenderer('tailwind', tailwindRenderer);
const config = book.render('tailwind');</Code>
    </details>
  </section>


  <!-- ─── Bring your own everything ─────────────────────────────────── -->
  <section class="extend">
    <header class="extend-head">
      <h2 class="rule-title">Your own rules and libraries.</h2>
      <p>The built-in selectors are a starting set. You can register any
        function that takes the token's resolved arguments (scopes arrive as
        scopes) and its options, and returns a value. Tokens that call it work
        like the built-ins: dependencies are tracked, cycles refused, values
        recomputed.</p>
    </header>

    <div class="extend-grid">
      <article class="extend-card">
        <h3>A custom function</h3>
        <p>Here I register a new selector, <code>warmest</code>, that picks the
          member leaning hardest towards orange: its chroma times how close its
          hue is to 50°. It runs on this page against the palette above.</p>
        <Folder>
          <Sheet name="code" label="Code"><Code is:raw>// Resolved args come first, the token's options last.
book.registerFunction('warmest', (scope) =&gt; {
  let best = null, bestScore = -Infinity;
  for (const key of scope.getAllKeys()) {
    const hex = scope.resolve(key);
    const { c = 0, h = 0 } = oklch(hex);
    const score = c * Math.cos((h - 50) * Math.PI / 180);
    if (score &gt; bestScore) { bestScore = score; best = hex; }
  }
  return best;
});

ui.set('warm', createFunctionToken('warmest', [values]));</Code></Sheet>
          <Sheet name="result" label="Result" front>
            <figure class="demo fn-polar">
              <svg class="fn-polar-chart" id="extend-fn-chart" viewBox="-110 -110 220 220" aria-hidden="true"></svg>
              <p class="fn-polar-readout" id="extend-fn-result">
                <span><span class="c-fn">warmest</span>(values) →</span>
                <span class="extend-result-swatch" id="extend-fn-swatch"></span>
                <code id="extend-fn-hex">—</code>
              </p>
              <div class="stub fn-polar-stub">
                <span>toward hue</span>
                <Slider id="extend-fn-hue" min="0" max="359" step="1" value="50" aria-label="Target hue" />
                <b id="extend-fn-hue-val">50°</b>
              </div>
            </figure>
          </Sheet>
        </Folder>
      </article>

      <article class="extend-card">
        <h3>Integration with a library</h3>
        <p>
          <a href="https://meodai.github.io/poline/" target="_blank" rel="noopener">Poline</a>
          generates a ramp between anchor colors. Put it straight into a scope
          and the selectors work on it like on any other palette.
        </p>
        <Folder>
          <Sheet name="code" label="Code"><Code is:raw>// two anchors across the wheel: a straight line
// through its centre, seven colors along it
const poline = new Poline({
  anchorColors: [[12, .85, .75], [192, .85, .75]],
  numPoints: 5,
});
const ramp = book.addScope('ramp');
poline.colorsCSS.forEach((c, i) => ramp.set(`s${i}`, color(c)));

ui.set('border', minContrastWith(
  ref('ui.surface'), ramp, { minContrast: 3 },
));</Code></Sheet>
          <Sheet name="result" label="Result" front>
            <div class="extend-result poline" id="extend-poline-result">
              <poline-picker class="extend-poline-picker" id="extend-poline-picker" tabindex="0" aria-label="Color wheel: drag around it, or use the arrow keys, to turn the line"></poline-picker>
              <div class="poline-strip" id="extend-poline-strip"></div>
              <p class="extend-result-line">
                <span is:raw class="extend-result-label">minContrastWith( ui.surface, ramp, { minContrast: 3 } ) → </span>
                <span class="extend-result-swatch" id="extend-poline-swatch"></span>
                <code id="extend-poline-hex">—</code>
              </p>
            </div>
          </Sheet>
        </Folder>
      </article>
    </div>
  </section>


                  <button type="button" data-offset="-1">−1</button>
                  <button type="button" data-offset="1" class="is-active">+1</button>
                  <button type="button" data-offset="2">+2</button>
                  <button type="button" data-offset="3">+3</button>
                </div>
                <label class="sibling-wrap"><input type="checkbox" id="sibling-wrap" /> wrap</label>
              </div>
            </figure>
          </Sheet>
          <Sheet name="result" label="Sizes" front>
            <figure class="demo">
              <figcaption>Click a row to move the anchor.</figcaption>
              <table class="ledger sib-table">
                <thead><tr><th>#</th><th>key</th><th>value</th><th></th></tr></thead>
                <tbody id="sib-rows"></tbody>
              </table>
              <div class="sibling-controls stub">
                <div class="sibling-offsets" id="sib-offsets" role="group" aria-label="Offset">
                  <button type="button" data-offset="-3">−3</button>
                  <button type="button" data-offset="-2">−2</button>
                  <button type="button" data-offset="-1">−1</button>
                  <button type="button" data-offset="1" class="is-active">+1</button>
                  <button type="button" data-offset="2">+2</button>
                  <button type="button" data-offset="3">+3</button>
                </div>
                <label class="sibling-wrap"><input type="checkbox" id="sib-wrap" /> wrap</label>
              </div>
            </figure>
          </Sheet>
        </Folder>
      </div>
    </article>

    </div>
  </main>


  <!-- ─── readableOn: contrast as a filter ─────────────────────────── -->
  <section class="readable-feature" aria-labelledby="readable-title">
    <div class="readable-feature-body split">
      <h2 class="rule-title" id="readable-title">Only readable colors.</h2>
      <div class="readable-feature-text">
        <p>Every color selector except the two contrast ones takes
          <code>readableOn</code> and <code>readableContrast</code> (4.5 by
          default). Members that don't reach the ratio against that backdrop
          are dropped before ranking, so <code>mostVivid</code> returns the
          loudest color that still reads and <code>closest</code> the nearest
          readable one. If nothing passes, the token throws an error instead of
          quietly returning an unreadable color. The backdrop is a reference,
          so switching themes runs the filter again.</p>
      </div>

      <Folder>
        <Sheet name="code" label="Code"><Code is:raw>ui.set('link', mostVivid(brand, {
  readableOn:  ref('ui.surface'),
  readableContrast: 4.5,
}));</Code></Sheet>
        <Sheet name="result" label="Result" front>
          <figure class="readable-stage">
            <figcaption>Faded members fail the ratio and never reach the ranking.</figcaption>
            <div class="readable-pool" id="readable-pool"></div>
            <div class="rdx" id="readable-results" aria-live="polite"></div>
            <div class="readable-controls stub">
              <label class="readable-surface">
                <color-input id="readable-surface" value="#0d0a03" initial-colorspace="hex" no-alpha=""></color-input>
                <span>ui.surface</span>
              </label>
              <div class="readable-ratios" id="readable-ratios" role="group" aria-label="readableContrast">
                <button type="button" data-ratio="3">3</button>
                <button type="button" data-ratio="4.5" class="is-active">4.5</button>
                <button type="button" data-ratio="7">7</button>
              </div>
            </div>
          </figure>
        </Sheet>
      </Folder>
    </div>
  </section>

  <!-- ─── ramp: single color → full tonal scale ────────────────────── -->
  <section class="ramp-feature" aria-labelledby="ramp-title">
    <div class="ramp-feature-body split">
      <h2 class="rule-title" id="ramp-title">A full scale from one color.</h2>
      <div class="ramp-feature-text">
        <p>Pick a brand color and <code>ramp()</code> returns the matching stop
          of a tonal scale copied from a design system you choose. It uses
          <a href="https://www.npmjs.com/package/dittotones" target="_blank" rel="noopener">dittotones</a>,
          which transfers the lightness and chroma curves of established
          palettes onto any hue: Tailwind, Radix, or masters of your own,
          even scopes of the book. One call per stop, and they all update
          when the brand color changes.</p>
        <p>Register ramps you drew yourself and new colors get their curve.
          It works best with many masters across your hues (at least two),
          all the same length and running light to dark.</p>
      </div>

      <Folder>
        <Sheet name="code" label="Code"><Code is:raw class="ramp-code">import { radixRamps } from 'dittotones/ramps/radix';

book.registerRamps('radix', radixRamps);
brand.set('primary', color('#3c61a0'));

const palette = book.addScope('palette');
for (const shade of ['1', '2', …, '12']) {
  palette.set(shade, ramp(ref('brand.primary'),
    { shade, from: 'radix' }));
}</Code></Sheet>
        <Sheet name="result" label="Result" front>
          <div class="ramp-stage">
            <div class="ramp-bars" id="ramp-bars"></div>
            <div class="ramp-seed stub">
              <color-input id="ramp-seed-input" value="#3c61a0" initial-colorspace="hex" no-alpha=""></color-input>
              <span class="ramp-seed-lbl">brand.primary</span>
              <select class="stub-select" id="ramp-from" aria-label="Masters to copy">
                <option value="tailwind-v3">Tailwind v3</option>
                <option value="tailwind-v4">Tailwind v4</option>
                <option value="radix">Radix</option>
              </select>
            </div>
          </div>
        </Sheet>
      </Folder>
    </div>

    <div class="names-feature-body split feature-sub">
      <h3 class="rule-title" id="names-title">Naming the steps.</h3>
      <div class="names-feature-text">
        <p>Generated colors still need keys. <code>scaleNames()</code> takes
          them from a naming convention (<code>50 … 950</code>, t-shirt sizes,
          an intensity ladder, 100 objects by size) and fits it to however many
          steps you have, keeping the ends and the center in place. If the count
          changes, run it again and every step gets a new, evenly spread name.</p>
        <p class="names-more">
          <a href={`${base}naming/`}>Try every scheme in the naming playground →</a>
        </p>
      </div>

      <Folder>
        <Sheet name="code" label="Code"><pre is:raw class="code" id="names-code"></pre></Sheet>
        <Sheet name="result" label="Result" front>
          <div class="names-stage">
            <div class="names-rows" id="names-rows" aria-live="polite"></div>
            <div class="stub">
              <div class="names-head">
                <div class="names-seed">
                  <color-input id="names-seed-input" value="#479549" initial-colorspace="hex" no-alpha=""></color-input>
                </div>
                <div class="names-schemes" id="names-schemes" role="group" aria-label="Naming scheme">
                  <button type="button" data-scheme="intensity" class="is-active">intensity</button>
                  <button type="button" data-scheme="hundreds">hundreds</button>
                  <button type="button" data-scheme="tshirt">tshirt</button>
                  <button type="button" data-scheme="tones">tones</button>
                  <button type="button" data-scheme="objects">objects</button>
                  <button type="button" data-scheme="things">things</button>
                  <button type="button" data-scheme="creatures">creatures</button>
                  <button type="button" data-scheme="greek">greek</button>
                </div>
              </div>
              <label class="names-count">
                <span>steps</span>
                <Slider id="names-count" min="3" max="9" value="9" />
                <b id="names-count-val">9</b>
              </label>
            </div>
          </div>
        </Sheet>
      </Folder>
    </div>

    <div class="order-feature-body split feature-sub">
      <h3 class="rule-title" id="order-title">Sorted scopes.</h3>
      <div class="order-feature-text">
        <p>Give a scope an <code>order</code> and it stays sorted by
          <code>value</code>, <code>name</code> or <code>type</code>, or a
          combination of them. Colors are sorted through
          <a href="https://github.com/darosh/colorsort-js" target="_blank" rel="noopener">colorsort-js</a>
          for a perceptually smooth sequence, dimensions by size. Every renderer
          and every positional selector (<code>nth</code>, <code>nextLarger</code>)
          reads the same order, and the scope re-sorts as soon as a value
          changes. Child scopes inherit their parent's order unless they set
          their own.</p>
      </div>

      <Folder>
        <Sheet name="code" label="Code"><Code is:raw>// colors, sizes and words, inserted in any order
const ui = book.addScope('ui', {
  order: [{ by: 'value' }],  // colors perceptual, sizes by size
});

ui.setOrder([{ by: 'name' }]);
ui.setOrder([
  { by: 'type', priority: ['color', 'dimension', 'string'] },
  { by: 'value' },           // then each group by value
]);

// your own: colors by lightness alone
book.registerOrderer('color', (entries) =>
  [...entries].sort((a, b) => L(a.resolved) - L(b.resolved)));</Code></Sheet>
        <Sheet name="result" label="Result" front>
          <div class="order-stage">
            <table class="ledger order-table">
              <thead><tr><th>#</th><th>key</th><th>type</th><th>value</th></tr></thead>
              <tbody id="order-swatches" aria-live="polite"></tbody>
            </table>
            <div class="order-head stub">
              <div class="order-modes" id="order-modes" role="group" aria-label="Sort criterion">
                <button type="button" data-mode="insertion">insertion</button>
                <button type="button" data-mode="value-asc" class="is-active">value</button>
                <button type="button" data-mode="value-desc">value ↓</button>
                <button type="button" data-mode="name">name</button>
                <button type="button" data-mode="type">type → value</button>
                <button type="button" data-mode="lightness">lightness</button>
              </div>
            </div>
          </div>
        </Sheet>
      </Folder>
    </div>
  </section>

  <!-- ─── Inheritance: layers across books, extends inside one ───────── -->
  <section class="extends-feature" aria-labelledby="extends-title">
    <div class="extends-head">
      <h2 class="rule-title" id="extends-title">Inherit, and override what changes.</h2>
    </div>

    <div class="extends-panels">
      <div class="extends-feature-body split" id="theme-extends">
        <div class="extends-feature-text">
          <p>When two variants live side by
            side, one scope can extend another. Every token carries over unless
            you redefine it, and the graph keeps track: change a token in the
            parent and everything that inherits it is recomputed. The editor dims
            inherited rows, so only the changes stand out. A full reference keeps
            pointing at the key it names; a <a href="#ref-relative-title">relative
            one</a> reads from the inheriting scope, and
            <a href="#ref-parent-title"><code>inherited</code></a> reads the value
            a scope overrides. Once a theme has to change root values across the
            whole system, use <a href="#layers-title">layers</a> instead.</p>
        </div>

        <Folder>
          <Sheet name="code" label="Code"><Code is:raw>const light = book.addScope('light');
light.set('bg',      color('#fffaed'));
light.set('text',    color('#0d0a03'));
light.set('primary', color('#3c61a0'));
light.set('accent',  color('#de5331'));
light.set('muted',   color('#908b7f'));

// dark inherits all five, overrides two
const dark = book.addScope('dark', {
  extends: 'light',
});
dark.set('bg',   color('#0d0a03'));
dark.set('text', color('#fffaed'));</Code></Sheet>
          <Sheet name="result" label="Result" front>
            <figure class="extends-stage">
              <div class="extends-pane">
                <div class="extends-pane-head">
                  <span class="extends-pane-name">dark</span>
                  <span class="extends-pane-meta">extends <code>light</code></span>
                </div>
                <div class="extends-rows">
                  <div class="ext-row ext-row--override">
                    <span class="ext-key">bg</span>
                    <span class="ext-swatch" style="background:#0d0a03"></span>
                    <span class="ext-val"><span class="c-fn">color</span>(<span class="c-str">'#0d0a03'</span>)</span>
                  </div>
                  <div class="ext-row ext-row--override">
                    <span class="ext-key">text</span>
                    <span class="ext-swatch" style="background:#fffaed"></span>
                    <span class="ext-val"><span class="c-fn">color</span>(<span class="c-str">'#fffaed'</span>)</span>
                  </div>
                  <div class="ext-row ext-row--inherited">
                    <span class="ext-key">primary</span>
                    <span class="ext-swatch" style="background:#3c61a0"></span>
                    <span class="ext-val">inherit <span class="ext-resolved">→ #3c61a0</span></span>
                  </div>
                  <div class="ext-row ext-row--inherited">
                    <span class="ext-key">accent</span>
                    <span class="ext-swatch" style="background:#de5331"></span>
                    <span class="ext-val">inherit <span class="ext-resolved">→ #de5331</span></span>
                  </div>
                  <div class="ext-row ext-row--inherited">
                    <span class="ext-key">muted</span>
                    <span class="ext-swatch" style="background:#908b7f"></span>
                    <span class="ext-val">inherit <span class="ext-resolved">→ #908b7f</span></span>
                  </div>
                </div>
              </div>
              <figcaption>Dimmed rows are inherited.</figcaption>
              <div class="ref-buttons ref-themes extends-cards" id="extends-cards"></div>
            </figure>
          </Sheet>
        </Folder>
      </div>
    </div>

    <div class="ref-feature-body split feature-sub">
      <h3 class="rule-title" id="ref-relative-title">Relative refs.</h3>
      <div class="ref-feature-text">
        <p>Leave the scope off, as in <code>ref('.bg')</code>, and the ref reads
          that key in whichever scope reads the token, much like
          <code>this</code> in a method, or a CSS <code>var()</code> that is
          looked up on the element using it.</p>
        <p>That is what makes extending scopes
          cheap. A variant overrides one value, and every inherited token that
          reads it relatively follows; nothing you already wrote has to be
          written again. Base and variant end up side by side, as
          <code>--button-hover</code> and <code>--button-danger-hover</code>.</p>
        <p>It also makes a scope speak about itself. A button's text can be
          <code>bestContrastWith(ref('.bg'), brand)</code>: the best contrast
          to its own background, whichever button it ends up in.</p>
      </div>

      <Folder>
        <Sheet name="code" label="Code"><Code is:raw>const btn = book.addScope('button');
btn.set('bg', ref('brand.primary'));
btn.set('fg', bestContrastWith(
  ref('.bg'), brand));
btn.set('hover', darken(ref('.bg'),
  { amount: 0.15 }));

// one root; fg and hover follow
book.addScope('button-danger', {
  extends: 'button',
}).set('bg', ref('brand.error'));</Code></Sheet>
        <Sheet name="result" label="Result" front>
          <figure class="ref-stage">
            <div class="ref-panes" id="ref-panes"></div>
            <div class="stub">
              <label class="ref-control">
                <color-input id="ref-danger" value="#de5331" initial-colorspace="hex" no-alpha=""></color-input>
                <span>brand.error</span>
              </label>
            </div>
          </figure>
        </Sheet>
      </Folder>
    </div>

    <div class="ref-feature-body split feature-sub">
      <h3 class="rule-title" id="ref-parent-title">Up the scope tree: inherited.</h3>
      <div class="ref-feature-text">
        <p>A token sits in two trees. Its <em>scope</em> may extend another
          scope, and its <em>value</em> may refer to another token. Design Book
          never climbs either on its own; two words climb them on purpose.</p>
        <p><code>inherited</code> climbs the scope tree. A scope that overrides
          <code>interaction</code> cannot read <code>ref('.interaction')</code>
          to work out the new value: that is the token it is defining, and the
          book refuses the cycle. <code>inherited(ref('.interaction'))</code>
          reads the one it replaces, the value it would have inherited;
          <code>inherited(ref, 2)</code> two scopes up, <code>inherited(ref,
          'root')</code> the top. Here a variant's hover is its parent's
          interaction color, two steps lighter along the blue ramp.</p>
      </div>

      <Folder>
        <Sheet name="code" label="Code"><Code is:raw>const base = book.addScope('base');
base.set('background', ref('blue.50'));
base.set('interaction', ref('blue.600'));

const hover = book.addScope('base-hover', {
  extends: 'base',
});
// two steps lighter than the one it replaces
hover.set('interaction', sibling(
  inherited(ref('.interaction')), ref('blue'), -2,
));</Code></Sheet>
        <Sheet name="result" label="Result" front>
          <figure class="ref-stage">
            <div class="ref-ramp" id="ref-ramp" aria-label="The blue ramp, with the three tokens marked"></div>
            <div class="ref-buttons" id="ref-buttons"></div>
          </figure>
        </Sheet>
      </Folder>
    </div>

    <div class="ref-feature-body split feature-sub">
      <h3 class="rule-title" id="ref-source-title">Back to the value: source.</h3>
      <div class="ref-feature-text">
        <p><code>source</code> climbs the other tree, the references.
          <code>card.interaction = ref('blue.600')</code>, so
          <code>source(ref('.interaction'))</code> is <code>blue.600</code>,
          the token it refers to; <code>source(ref, 'root')</code> follows
          the references to the token where the value is written.</p>
        <p>It is how you move relative to a value in the scale it was
          generated in: a step lighter, a size up, without looking up the next
          shade and typing it in. When you know the scale, name it:
          <code>sibling(ref('.interaction'), ref('blue'), -2)</code>. When a
          rule is shared by themes whose colors come from different ramps, let
          it go back to wherever the value comes from: one rule, a blue button
          and a green one.</p>
      </div>

      <Folder>
        <Sheet name="code" label="Code"><Code is:raw>const button = book.addScope('button');
button.set('interaction', ref('blue.500'));
// two steps lighter, in whichever ramp
// the interaction color comes from
button.set('hover', sibling(
  source(ref('.interaction'), 'root'), -2,
));

book.addScope('button-green', { extends: 'button' })
  .set('interaction', ref('green.500'));</Code></Sheet>
        <Sheet name="result" label="Result" front>
          <figure class="ref-stage">
            <div class="ref-buttons ref-themes" id="ref-themes"></div>
          </figure>
        </Sheet>
      </Folder>
    </div>

      <div class="extends-feature-body split feature-sub" id="theme-layers">
        <h3 class="rule-title" id="layers-title">Across a whole system: layers.</h3>
        <div class="extends-feature-text">
          <p>Every shop in a chain shares
            the brand, but the old-town store has its own accent. Write the
            shop's system once as a layer; each store is another layer that only
            holds what's different about it, here a single color. Composing a
            book from the stack puts the override into the same graph as
            everything else, so every ref and selector built on that color
            is recomputed.</p>
        </div>

        <Folder>
          <Sheet name="code" label="Code"><Code is:raw>const system = layer('store-system', (book) =&gt; {
  const brand = book.addScope('brand');
  brand.set('highlight', color('#3c61a0'));
  // … ink, paper …
  const ui = book.addScope('ui');
  ui.set('link',  ref('brand.highlight'));
  ui.set('hover', darken(ref('ui.link'),
    { amount: 0.2 }));
  ui.set('tint', colorMix(ref('ui.link'),
    ref('brand.paper'), { ratio: 0.85 }));
});

// a store is only what sets it apart
const oldTown = layer('old-town', {
  brand: { highlight: color('#de5331') },
});
const harbour = layer('harbour', {
  brand: { highlight: color('#479549') },
});

composeBook('old-town', [system, oldTown]);</Code></Sheet>
          <Sheet name="result" label="Result" front>
            <figure class="extends-stage">
              <div class="extends-pane">
                <div class="extends-pane-head">
                  <span class="extends-pane-name">old-town</span>
                  <span class="extends-pane-meta">on <code>store-system</code></span>
                </div>
                <div class="extends-rows extends-rows--keys">
                  <div class="ext-row ext-row--override">
                    <span class="ext-key">brand.highlight</span>
                    <span class="ext-swatch" style="background:#de5331"></span>
                    <span class="ext-val"><span class="c-fn">color</span>(<span class="c-str">'#de5331'</span>) <span class="ext-layer">old-town</span></span>
                  </div>
                  <div class="ext-row ext-row--override">
                    <span class="ext-key">ui.link</span>
                    <span class="ext-swatch" style="background:#de5331"></span>
                    <span class="ext-val"><span class="c-fn">ref</span> <span class="ext-resolved">→ #de5331</span></span>
                  </div>
                  <div class="ext-row ext-row--override">
                    <span class="ext-key">ui.hover</span>
                    <span class="ext-swatch" style="background:#a53b22"></span>
                    <span class="ext-val"><span class="c-fn">darken</span> <span class="ext-resolved">→ #a53b22</span></span>
                  </div>
                  <div class="ext-row ext-row--override">
                    <span class="ext-key">ui.tint</span>
                    <span class="ext-swatch" style="background:#f0d4c1"></span>
                    <span class="ext-val"><span class="c-fn">colorMix</span> <span class="ext-resolved">→ #f0d4c1</span></span>
                  </div>
                  <div class="ext-row ext-row--inherited">
                    <span class="ext-key">brand.ink</span>
                    <span class="ext-swatch" style="background:#0d0a03"></span>

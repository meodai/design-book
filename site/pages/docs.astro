---
import Page from '../layouts/Page.astro';
import BrandMark from '../components/BrandMark.astro';
import InstallBar from '../components/InstallBar.astro';
import Footer from '../components/Footer.astro';
import { partial } from '../lib/partial';
import markup from '../partials/docs.html?raw';
import '../../marketing/style.css';
import '../../marketing/shared.css';
import '../../marketing/docs.css';
const [beforeBrand, afterBrand] = partial(markup);
---
<Page
  title="Design Book — Rules behind a design system"
  description="A reactive engine for the decisions inside a design system. Express rules, not values; render the result to any target."
  fonts={['https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&display=swap']}
>

  <Fragment set:html={beforeBrand} />
  <BrandMark />
  <Fragment set:html={afterBrand} />
  <InstallBar />
  <Footer current="docs" />
  <script>
    // In this order: the folders are built before the demos fill them.
    import '../../marketing/docs-folders.js';
    import '../../marketing/script.js';
    import '../../marketing/docs-rails.js';
    import '../../marketing/sliders.js';
  </script>
</Page>
